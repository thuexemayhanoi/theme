        {
          "level": 2,
          "text": "Bảng giá thuê xe máy Hà Nội hàng tháng – Nhiều xe, giao nhanh, tiện lợi"
        },
        {
          "level": 2,
          "text": "Cho thuê xe máy các loại theo tháng Hà Nội – Tiện lợi, giá tốt"
